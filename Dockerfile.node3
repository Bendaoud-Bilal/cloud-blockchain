# Dockerfile for Blockchain Node 3
FROM python:3.9-slim

LABEL maintainer="Blockchain Node 3"
LABEL description="Independent blockchain node 3"

WORKDIR /app

# Copy requirements and install dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy blockchain node files
COPY blockchain/ ./blockchain/

# Create data directory for persistence
RUN mkdir -p /app/data

# Set environment variables for this node
ENV NODE_ID=node3
ENV FLASK_HOST=0.0.0.0
ENV FLASK_PORT=5000

WORKDIR /app/blockchain

# Expose default port
EXPOSE 5000

# Run the blockchain node
CMD ["python", "blockchain.py", "-p", "5000"]
